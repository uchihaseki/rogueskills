        },
        {
          "id": "release-step-2",
          "order": 2,
          "instruction": "Capture candidate commit, check-run, pull-request, and rollback evidence with immutable GitHub URLs and evidence IDs before declaring release readiness.",
          "tool": "GitHub REST API"
        },
        {
          "id": "release-step-3",
          "order": 3,
          "instruction": "Classify failing and pending checks without changing their provider status."
        },
        {
          "id": "release-step-4",
          "order": 4,
          "instruction": "Return ready, review, or blocked with finding-level evidence IDs and explicit data gaps."
        }
      ]
    },
    "inputs": [
      "GitHub owner/repository",
      "Candidate ref",
      "Base branch"
    ],
    "outputs": [
      "Typed release-readiness report",
      "Evidence-bound release recommendation"
    ],
    "constraints": [
      "Never declare a release ready when required CI evidence is missing or failing.",
      "Never fabricate a check, review, commit, or pull-request status.",
