      "objective": "Determine whether a candidate ref is ready, needs review, or is blocked.",
      "instruction": "Use only captured GitHub evidence, preserve data gaps, and never infer a successful status."
    },
    "workflow": {
      "steps": [
        {
          "id": "release-step-1",
          "order": 1,
          "instruction": "Resolve the candidate ref to an immutable GitHub commit SHA.",
