{
  "name": "rogueskills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "PYTHONPATH=backend .venv/bin/python -m rogueskills.main",
    "start-win": "set \"PYTHONPATH=backend\" && .venv\\Scripts\\python.exe -m rogueskills.main",
    "test": "node --test && PYTHONPATH=backend .venv/bin/python -m unittest tests.python.test_domain",
    "test:python": "PYTHONPATH=backend .venv/bin/python -m pytest tests/python",
    "test:python-domain": "PYTHONPATH=backend .venv/bin/python -m unittest tests.python.test_domain -v",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:legacy": "node --test tests/backend/*.test.js tests/core/*.test.js tests/integration/*.test.js",
    "demo:awesome-finance": "PYTHONPATH=backend .venv/bin/python scripts/run_awesome_finance_self_evolution.py",
    "demo:awesome-finance-replay": "PYTHONPATH=backend .venv/bin/python scripts/run_awesome_finance_verified_replay.py",
    "demo:awesome-finance-preset-validation": "PYTHONPATH=backend .venv/bin/python scripts/run_awesome_finance_preset_validation.py",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:type-check": "npm run type-check --prefix frontend"
  }
}
